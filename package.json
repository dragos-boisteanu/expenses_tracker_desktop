{
  "name": "ExpensesTracker",
  "version": "0.0.20",
  "private": true,
  "author": "Dragos",
  "type": "module",
  "main": "dist/electron/main.js",
  "repository": "https://github.com/dragos-boisteanu/expenses_tracker_desktop_release",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "desktop:dev": "tsc && concurrently  \"vite\" \"electron .\" \"tsc -w\"",
    "desktop:build": "cross-env VITE_TARGET=desktop npm run build && tsc && electron-builder",
    "preview": "vite preview",
    "rebuild-sqlite3": "electron-rebuild -f -w better-sqlite3",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "create:migration": "node src/scripts/create-migration.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tiptap/pm": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@tiptap/vue-3": "^3.27.1",
    "@vuepic/vue-datepicker": "^14.0.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.6.2",
    "papaparse": "^5.5.2"
  },
  "devDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/devtools": "^8.1.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^14.3.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "~10.0.0",
    "jiti": "^2.4.2",
    "node-abi": "^4.24.0",
    "npm-run-all2": "^7.0.2",
    "overlayscrollbars-vue": "^0.5.9",
    "pinia": "^3.0.3",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "virtua": "^0.40.4",
    "vite": "^8.1.5",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.10"
  }
}
