{
  "name": "Expenses_Tracker",
  "version": "0.0.1",
  "private": true,
  "author": "Dragos",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "desktop:dev": "tsc && concurrently vite \" electron .\" \"tsc -w\"",
    "desktop:build": "cross-env VITE_TARGET=desktop   npm run build && tsc && npm run rebuild-sqlite3 &&  electron-builder",
    "preview": "vite preview",
    "rebuild-sqlite3": "electron-rebuild -f -w better-sqlite3",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "postinstall": "electron-builder install-app-deps",
  "dependencies": {
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.0.17",
    "@tsconfig/node22": "^22.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/core": "^13.1.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9.21.0",
    "eslint-plugin-vue": "~10.0.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^7.0.2",
    "overlayscrollbars-vue": "^0.5.9",
    "pinia": "^3.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.17",
    "typescript": "~5.8.0",
    "virtua": "^0.40.4",
    "vite": "6.2.6",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.8"
  }
}
