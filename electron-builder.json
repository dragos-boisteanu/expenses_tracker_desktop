{
  "appId": "com.dragos.expensestracker",
  "productName": "Expenses Tracker",
  "asar": true,
  "directories": {
    "buildResources": "src/assets",
    "output": "release"
  },
  "buildDependenciesFromSource": true,
  "files": [
    "dist/**/*",
    {
      "from": "src/assets",
      "to": "assets",
      "filter": ["**/*"]
    }
  ],
  "extraResources": [
    {
      "from": "src/assets",
      "to": "assets",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "src/assets/windows/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Expenses_Tracker_${version}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": true,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": true
  }
}
